{
  "$comment": [
    "Shared contract between the Flutter client (client/) and this FastAPI backend (backend/).",
    "The two repos are versioned separately, so a rename on one side would silently break the other.",
    "backend/tests/test_api_contract.py asserts the real FastAPI routes and pydantic models match this file.",
    "client/test/integration/api_contract_test.dart asserts the Flutter client's HTTP calls and JSON parsers match this file.",
    "When you change an endpoint, change it here FIRST, then fix whichever side the test turns red on."
  ],
  "version": 1,
  "base_path": "/api/v1",
  "enums": {
    "transfer_status": ["uploading", "ready", "expired", "cancelled"],
    "file_status": ["pending", "uploaded", "failed"],
    "receiver_session_status": ["waiting", "attached", "expired"]
  },
  "endpoints": [
    {
      "method": "POST",
      "path": "/transfers",
      "client_path": "transfers",
      "client_uses": true,
      "request_body": {
        "files": [
          {
            "file_name": "string",
            "file_size": "integer",
            "content_type": "string"
          }
        ]
      },
      "response_fields": [
        "transfer_id",
        "status",
        "total_files",
        "total_size",
        "expires_in",
        "files",
        "sender_secret",
        "access_token"
      ],
      "response_sample": {
        "transfer_id": "sample-transfer-id",
        "status": "uploading",
        "total_files": 1,
        "total_size": 1024,
        "expires_in": 3600,
        "sender_secret": "sample-sender-secret",
        "access_token": "sample-access-token",
        "files": [
          {
            "file_id": "sample-file-id",
            "file_name": "sample.bin",
            "file_size": 1024,
            "upload_url": "https://r2.example/upload/sample-file-id"
          }
        ]
      },
      "client_model": "TransferModel"
    },
    {
      "method": "POST",
      "path": "/transfers/{transfer_id}/files/{file_id}/complete",
      "client_path": "transfers/{transfer_id}/files/{file_id}/complete",
      "client_uses": true,
      "request_body": null,
      "response_fields": ["file_id", "status", "transfer_status"],
      "response_sample": {
        "file_id": "sample-file-id",
        "status": "uploaded",
        "transfer_status": "ready"
      },
      "client_model": null
    },
    {
      "method": "GET",
      "path": "/transfers/{transfer_id}",
      "client_path": "transfers/{transfer_id}",
      "client_uses": true,
      "request_body": null,
      "response_fields": [
        "transfer_id",
        "status",
        "total_files",
        "total_size",
        "expires_in",
        "files"
      ],
      "response_sample": {
        "transfer_id": "sample-transfer-id",
        "status": "ready",
        "total_files": 1,
        "total_size": 1024,
        "expires_in": 3600,
        "files": [
          {
            "file_id": "sample-file-id",
            "file_name": "sample.bin",
            "file_size": 1024,
            "content_type": "application/octet-stream"
          }
        ]
      },
      "client_model": "TransferModel"
    },
    {
      "method": "POST",
      "path": "/transfers/{transfer_id}/downloads",
      "client_path": "transfers/{transfer_id}/downloads",
      "client_uses": true,
      "request_body": {
        "file_ids": ["string"]
      },
      "response_fields": ["files"],
      "response_sample": {
        "files": [
          {
            "file_id": "sample-file-id",
            "file_name": "sample.bin",
            "download_url": "https://r2.example/download/sample-file-id",
            "expires_in": 900
          }
        ]
      },
      "client_model": "FileItemModel"
    },
    {
      "method": "DELETE",
      "path": "/transfers/{transfer_id}",
      "client_path": "transfers/{transfer_id}",
      "client_uses": true,
      "request_body": null,
      "response_fields": [],
      "response_sample": null,
      "client_model": null
    },
    {
      "method": "POST",
      "path": "/transfers/{transfer_id}/extend",
      "client_path": null,
      "client_uses": false,
      "request_body": null,
      "response_fields": ["transfer_id", "status", "expires_in"],
      "response_sample": {
        "transfer_id": "sample-transfer-id",
        "status": "ready",
        "expires_in": 3600
      },
      "client_model": null
    },
    {
      "method": "GET",
      "path": "/transfers/{transfer_id}/turn-credentials",
      "client_path": null,
      "client_uses": false,
      "request_body": null,
      "response_fields": [],
      "response_sample": null,
      "client_model": null
    },
    {
      "method": "POST",
      "path": "/receiver-sessions",
      "client_path": "receiver-sessions",
      "client_uses": true,
      "request_body": null,
      "response_fields": ["session_id", "status", "expires_in"],
      "response_sample": {
        "session_id": "sample-session-id",
        "status": "waiting",
        "expires_in": 600
      },
      "client_model": "ReceiverSessionModel"
    },
    {
      "method": "GET",
      "path": "/receiver-sessions/{session_id}",
      "client_path": "receiver-sessions/{session_id}",
      "client_uses": true,
      "request_body": null,
      "response_fields": [
        "session_id",
        "status",
        "transfer_id",
        "wrapped_key",
        "expires_in"
      ],
      "response_sample": {
        "session_id": "sample-session-id",
        "status": "attached",
        "transfer_id": "sample-transfer-id",
        "wrapped_key": "sample-wrapped-key",
        "expires_in": 600
      },
      "client_model": "ReceiverSessionModel"
    },
    {
      "method": "POST",
      "path": "/receiver-sessions/{session_id}/attach-transfer",
      "client_path": "receiver-sessions/{session_id}/attach-transfer",
      "client_uses": true,
      "request_body": {
        "transfer_id": "string",
        "wrapped_key": "string"
      },
      "response_fields": [],
      "response_sample": null,
      "client_model": null
    },
    {
      "method": "DELETE",
      "path": "/receiver-sessions/{session_id}",
      "client_path": "receiver-sessions/{session_id}",
      "client_uses": true,
      "request_body": null,
      "response_fields": [],
      "response_sample": null,
      "client_model": null
    }
  ]
}
