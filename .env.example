# App configuration
# ENVIRONMENT=production hides /docs, /redoc and /openapi.json, refuses to
# start while any R2 credential is still a mock-* default, and drops
# localhost/127.0.0.1 entries from ALLOWED_ORIGINS.
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Redis configuration
# Compose interpolates this into the Redis server command and into the web
# service's REDIS_URL, so it must be set or `docker compose` refuses to start.
# The same value must appear (URL-encoded) in the local REDIS_URL below.
REDIS_PASSWORD=replace-with-a-long-random-password
REDIS_URL=redis://:replace-with-a-long-random-password@localhost:6379/0

# Cloudflare R2 configuration (required for real uploads)
# Use your own bucket and API token. The built-in mock-* defaults cannot store files.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your-bucket-name

# Limits
MAX_FILES_PER_TRANSFER=10
# One file and the whole transfer both stop at 50 MB.
MAX_INDIVIDUAL_FILE_SIZE=52428800
MAX_TOTAL_TRANSFER_SIZE=52428800
# Default session = 10 min; extended (rewarded ad) = 30 min
TRANSFER_LIFETIME_SECONDS=600
EXTENDED_TRANSFER_LIFETIME_SECONDS=1800
RECEIVER_SESSION_LIFETIME_SECONDS=600
UPLOAD_URL_LIFETIME_SECONDS=900
DOWNLOAD_URL_LIFETIME_SECONDS=300

# CORS — comma-separated JSON list of allowed origins. No wildcard.
# In production, localhost/127.0.0.1 entries are removed automatically.
ALLOWED_ORIGINS=["https://lynkshare.app","http://localhost:8000","http://localhost:3000"]

# TURN relay (P2P cross-network fallback). Leave empty to disable.
TURN_URLS=
TURN_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=600

# Signaling (WebRTC P2P)
# Refuse a socket whose session id is not a live transfer or receiver session.
SIGNALING_VALIDATE_SESSION=true
# Require the transfer access token in the socket's first frame (#32). Turn it off
# only while clients in the field still predate e4b0a02; the relay swallows the
# frame either way.
SIGNALING_REQUIRE_ACCESS=true
