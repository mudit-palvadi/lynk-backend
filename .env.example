# App configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Redis configuration
REDIS_URL=redis://localhost:6379/0

# Cloudflare R2 configuration
# Leave empty during initial local development, but fill in to test actual uploads
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=lynk-transfers

# Limits
MAX_FILES_PER_TRANSFER=10
# Cloud/R2 tiers: free = 20 MB, rewarded-ad unlock = 50 MB (server ceiling)
MAX_INDIVIDUAL_FILE_SIZE=52428800
MAX_TOTAL_TRANSFER_SIZE=524288000
# Default session = 10 min; extended (rewarded ad) = 30 min
TRANSFER_LIFETIME_SECONDS=600
EXTENDED_TRANSFER_LIFETIME_SECONDS=1800
RECEIVER_SESSION_LIFETIME_SECONDS=600
UPLOAD_URL_LIFETIME_SECONDS=900
DOWNLOAD_URL_LIFETIME_SECONDS=300

# CORS — comma-separated JSON list of allowed origins. No wildcard.
ALLOWED_ORIGINS=["https://lynkshare.app","http://localhost:8000","http://localhost:3000"]

# TURN relay (P2P cross-network fallback). Leave empty to disable.
TURN_URLS=
TURN_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=600

# Signaling (WebRTC P2P)
# Refuse a socket whose session id is not a live transfer or receiver session.
SIGNALING_VALIDATE_SESSION=true
# Require the transfer access token in the socket's first frame (#32). Turn it off
# only while clients in the field still predate e4b0a02; the relay swallows the
# frame either way.
SIGNALING_REQUIRE_ACCESS=true
